@echo off
rem Cai add-in "PhongEm.Phys - Dinh dang de thi" cho Word.
rem Cai qua "thu muc dung chung" (Trusted Add-in Catalog) de the PhongEm.Phys LUON HIEN tren Ribbon moi lan mo Word.
rem QL_Format va PhongEm.Phys dung CHUNG mot thu muc %PUBLIC%\WordAddins (chia se ten WordAddins), moi add-in mot file:
rem Word chi hien 1 thu muc dung chung trong menu, nen hai add-in phai nam chung mot cho thi moi cai song song duoc.
rem KHONG xoa bo nho tam Wef cua Word (xoa se lam mat cac add-in khac da them).
setlocal
set "C=%PUBLIC%\WordAddins"
set "F=PhongEm.Phys.xml"
:chodong
tasklist /fi "imagename eq WINWORD.EXE" 2>nul | find /i "WINWORD.EXE" >nul && (
  echo Word dang mo. Hay LUU tai lieu va DONG HET Word, roi bam phim bat ky de tiep tuc...
  pause >nul
  goto chodong
)
if not exist "%C%" mkdir "%C%"
rem Chuyen add-in da cai kieu cu (moi add-in mot thu muc chia se rieng) sang thu muc chung
if exist "%PUBLIC%\QLPhysics\QLFormat\manifest.xml" if not exist "%C%\QL_Format.xml" copy /y "%PUBLIC%\QLPhysics\QLFormat\manifest.xml" "%C%\QL_Format.xml" >nul
if exist "%PUBLIC%\PhongEmPhys\Addin\manifest.xml" if not exist "%C%\PhongEm.Phys.xml" copy /y "%PUBLIC%\PhongEmPhys\Addin\manifest.xml" "%C%\PhongEm.Phys.xml" >nul
rem Kiem tra phien ban Word (doc ban cua file WINWORD.EXE, du phong: VersionToReport): tu ban 2205 (build 15225) tro len dung che do chay thuong truc
set "WB=0"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$b=0; try{$p=(Get-ItemProperty 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\App Paths\Winword.exe' -ErrorAction Stop).'(default)'; $b=[int]((Get-Item $p).VersionInfo.FileBuildPart)}catch{}; if($b -eq 0){try{$v=(Get-ItemProperty 'HKLM:\SOFTWARE\Microsoft\Office\ClickToRun\Configuration' -ErrorAction Stop).VersionToReport; $b=[int]($v.Split('.')[2])}catch{}}; $b" > "%TEMP%\qlf_wb.txt" 2>nul
if exist "%TEMP%\qlf_wb.txt" set /p WB=<"%TEMP%\qlf_wb.txt"
set /a WB=%WB%+0 >nul 2>&1 || set "WB=0"
set "M=manifest_cu.xml"
if %WB% GEQ 15225 set "M=manifest.xml"
if "%M%"=="manifest.xml" (echo Word build %WB%: dung che do nhanh - chay thuong truc.) else (echo Word build %WB%: dung che do thuong.)
echo Dang tai file cau hinh add-in PhongEm.Phys...
if exist "%C%\%F%.tmp" del /q "%C%\%F%.tmp"
powershell -NoProfile -ExecutionPolicy Bypass -Command "[Net.ServicePointManager]::SecurityProtocol=[Net.SecurityProtocolType]::Tls12; try { Invoke-WebRequest -UseBasicParsing -Uri 'https://qlphys.github.io/dinhdangde/addin/pe/%M%' -OutFile '%C%\%F%.tmp' } catch { Remove-Item -LiteralPath '%C%\%F%.tmp' -ErrorAction SilentlyContinue }"
if exist "%C%\%F%.tmp" (
  move /y "%C%\%F%.tmp" "%C%\%F%" >nul
) else if exist "%~dp0%M%" (
  echo Khong tai duoc qua mang, dung file %M% di kem bo cai.
  copy /y "%~dp0%M%" "%C%\%F%" >nul
) else if exist "%C%\%F%" (
  echo Khong tai duoc qua mang, giu file cau hinh da co tren may.
)
if not exist "%C%\%F%" (
  echo KHONG TAI DUOC. Kiem tra mang Internet roi chay lai.
  pause
  exit /b 1
)
set "UNC=\\%COMPUTERNAME%\WordAddins"
rem Thu muc chung da chia se san va khong con kieu cai cu: khong can hoi quyen quan tri nua
if exist "%UNC%\%F%" if not exist "%PUBLIC%\QLPhysics\QLFormat\" if not exist "%PUBLIC%\PhongEmPhys\Addin\" goto dachiase
echo.
echo Dang tao thu muc dung chung cho add-in.
echo  Windows se hien hop "Ban co muon cho phep ung dung nay thay doi thiet bi?" - hay chon YES (Co).
powershell -NoProfile -ExecutionPolicy Bypass -Command "try { Start-Process -FilePath powershell.exe -Verb RunAs -Wait -WindowStyle Hidden -ArgumentList '-NoProfile -ExecutionPolicy Bypass -EncodedCommand ' } catch { }"
:dachiase
if not exist "%UNC%\%F%" goto cachcu
powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand 
rem Bo cach cai cu (Developer / thu muc rieng) cua add-in da nam trong thu muc chung, tranh 2 the trung nhau
if exist "%C%\QL_Format.xml" (
  reg delete "HKCU\Software\Microsoft\Office\16.0\WEF\Developer" /v "QLPhysDinhDangDe" /f >nul 2>&1
  reg delete "HKCU\Software\Microsoft\Office\16.0\WEF\Developer" /v "QLPhysThuSR" /f >nul 2>&1
  if exist "%LOCALAPPDATA%\QLPhysics\DinhDangDe" rmdir /s /q "%LOCALAPPDATA%\QLPhysics\DinhDangDe"
  if exist "%LOCALAPPDATA%\QLPhysics\ThuSR" rmdir /s /q "%LOCALAPPDATA%\QLPhysics\ThuSR"
  if exist "%PUBLIC%\QLPhysics\QLFormat" rmdir /s /q "%PUBLIC%\QLPhysics\QLFormat"
  rmdir "%PUBLIC%\QLPhysics" >nul 2>&1
)
if exist "%C%\PhongEm.Phys.xml" (
  reg delete "HKCU\Software\Microsoft\Office\16.0\WEF\Developer" /v "PhongEmPhys" /f >nul 2>&1
  if exist "%LOCALAPPDATA%\PhongEmPhys\Addin" rmdir /s /q "%LOCALAPPDATA%\PhongEmPhys\Addin"
  rmdir "%LOCALAPPDATA%\PhongEmPhys" >nul 2>&1
  if exist "%PUBLIC%\PhongEmPhys\Addin" rmdir /s /q "%PUBLIC%\PhongEmPhys\Addin"
  rmdir "%PUBLIC%\PhongEmPhys" >nul 2>&1
)
echo.
echo DA CAI XONG PhongEm.Phys (thu muc dung chung: %UNC%).
echo  LAM 1 LAN DUY NHAT sau khi cai:
echo   1. Mo Word, mo mot file bat ky.
echo   2. Insert (Chen) ^> My Add-ins (Phan bo tro cua toi)
echo      (Word moi: Home ^> Add-ins ^> More Add-ins / Advanced)
echo   3. Chon the SHARED FOLDER (THU MUC DUNG CHUNG) ^> PhongEm.Phys ^> Add (Them).
echo  May co ca QL_Format va PhongEm.Phys thi ca hai cung nam trong the SHARED FOLDER: them lan luot tung cai.
echo  Tu lan sau, moi lan mo Word the "PhongEm.Phys" luon co san tren Ribbon.
echo.
pause
exit /b 0

:cachcu
echo.
echo KHONG TAO DUOC THU MUC DUNG CHUNG (chua cho phep quyen quan tri, hoac may chan chia se).
echo Tam cai theo cach cu. Luu y: voi ban Word moi, moi lan mo Word co the phai goi lai add-in:
echo   Insert (Chen) ^> My Add-ins ^> Developer Add-ins ^> PhongEm.Phys.
echo Muon the PhongEm.Phys luon hien: chay lai bo cai nay va chon YES khi Windows hoi.
set "D=%LOCALAPPDATA%\PhongEmPhys\Addin"
if not exist "%D%" mkdir "%D%"
copy /y "%C%\%F%" "%D%\manifest.xml" >nul
reg add "HKCU\Software\Microsoft\Office\16.0\WEF\Developer" /v "PhongEmPhys" /t REG_SZ /d "%D%\manifest.xml" /f >nul
echo.
pause
