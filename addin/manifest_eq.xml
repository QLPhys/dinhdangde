      <bt:LongStrings><bt:String id="T.Dung" DefaultValue="Đặt con nháy ở dòng phương án (Phần I) hoặc dòng ý a) b) c) d) (Phần II) rồi bấm: đánh dấu là đúng."/><bt:String id="T.Sai" DefaultValue="Phần II: đặt con nháy ở dòng ý rồi bấm để đánh dấu ý đó sai. Phần I: bỏ đánh dấu phương án tại con nháy."/><bt:String id="T.DapSo" DefaultValue="Câu trả lời ngắn (Phần III): con nháy ở bất kỳ đâu trong câu, bấm để nhập đáp số. Công cụ ghi dòng &quot;Đáp án: …&quot;."/><bt:String id="T.A" DefaultValue="Con nháy ở bất kỳ đâu trong câu trắc nghiệm Phần I: gạch chân nhãn A. làm đáp án đúng, bỏ đánh dấu các phương án khác."/><bt:String id="T.B" DefaultValue="Con nháy ở bất kỳ đâu trong câu trắc nghiệm Phần I: gạch chân nhãn B. làm đáp án đúng, bỏ đánh dấu các phương án khác."/><bt:String id="T.C" DefaultValue="Con nháy ở bất kỳ đâu trong câu trắc nghiệm Phần I: gạch chân nhãn C. làm đáp án đúng, bỏ đánh dấu các phương án khác."/><bt:String id="T.D" DefaultValue="Con nháy ở bất kỳ đâu trong câu trắc nghiệm Phần I: gạch chân nhãn D. làm đáp án đúng, bỏ đánh dấu các phương án khác."/><bt:String id="T.LvB" DefaultValue="Gắn nhãn mức độ Biết (B) cho câu tại con nháy hoặc các câu đang bôi đen."/><bt:String id="T.LvH" DefaultValue="Gắn nhãn mức độ Hiểu (H) cho câu tại con nháy hoặc các câu đang bôi đen."/><bt:String id="T.LvVD" DefaultValue="Gắn nhãn mức độ Vận dụng (VD) cho câu tại con nháy hoặc các câu đang bôi đen."/><bt:String id="T.LvVDC" DefaultValue="Gắn nhãn mức độ Vận dụng cao (VDC) cho câu tại con nháy hoặc các câu đang bôi đen."/><bt:String id="T.LvX" DefaultValue="Xóa nhãn mức độ của câu tại con nháy hoặc các câu đang bôi đen."/><bt:String id="T.MucDo" DefaultValue="Gắn nhãn mức độ cho câu tại con nháy (bôi đen nhiều câu để gắn cho tất cả). Tự ghép TN / DS / TLN theo phần."/><bt:String id="T.C2" DefaultValue="Gắn [CHUM-2] vào đầu đoạn dữ kiện tại con nháy."/><bt:String id="T.C3" DefaultValue="Gắn [CHUM-3] vào đầu đoạn dữ kiện tại con nháy."/><bt:String id="T.C4" DefaultValue="Gắn [CHUM-4] vào đầu đoạn dữ kiện tại con nháy."/><bt:String id="T.C5" DefaultValue="Gắn [CHUM-5] vào đầu đoạn dữ kiện tại con nháy."/><bt:String id="T.C0" DefaultValue="Xóa dấu [CHUM-n] ở đoạn tại con nháy."/><bt:String id="T.Chum" DefaultValue="Đặt con nháy ở đoạn dữ kiện dùng chung, chọn số câu đi sau dùng dữ kiện này."/><bt:String id="T.Ph1" DefaultValue="Chèn (hoặc đổi) dòng &quot;PHẦN I. CÂU TRẮC NGHIỆM PHƯƠNG ÁN NHIỀU LỰA CHỌN&quot; ngay trước câu tại con nháy."/><bt:String id="T.Ph2" DefaultValue="Chèn (hoặc đổi) dòng &quot;PHẦN II. CÂU TRẮC NGHIỆM ĐÚNG SAI&quot; ngay trước câu tại con nháy."/><bt:String id="T.Ph3" DefaultValue="Chèn (hoặc đổi) dòng &quot;PHẦN III. CÂU TRẮC NGHIỆM TRẢ LỜI NGẮN&quot; ngay trước câu tại con nháy."/><bt:String id="T.Ph4" DefaultValue="Chèn (hoặc đổi) dòng &quot;PHẦN IV. TỰ LUẬN&quot; ngay trước câu tại con nháy."/><bt:String id="T.LT" DefaultValue="Gắn [LT] ở đầu dòng tại con nháy: từ dòng này là phần lý thuyết (giữ ở cả bản GV và HS). Bấm lại để bỏ."/><bt:String id="T.BT" DefaultValue="Gắn [BT] ở đầu dòng tại con nháy: từ dòng này là phần bài tập. Bấm lại để bỏ."/><bt:String id="T.Phan" DefaultValue="Chèn dòng tiêu đề PHẦN I–IV trước câu tại con nháy (đổi nếu đã có); đánh dấu đầu phần lý thuyết [LT] hoặc bài tập [BT]."/><bt:String id="T.ThemHDG" DefaultValue="Thêm dòng &quot;Hướng dẫn giải&quot; ở cuối câu tại con nháy và đặt con nháy ở dòng dưới để gõ lời giải."/><bt:String id="T.Equation" DefaultValue="Đổi công thức gõ thường (n = 1,505.10^23 / 6,02.10^23 = 0,25 mol) thành Equation của Word. Bôi đen đoạn cần đổi, hoặc để con nháy trong dòng để đổi cả dòng. Viết: ^ mũ, _ chỉ số dưới, / phân số, sqrt( ) căn."/><bt:String id="T.CanXem" DefaultValue="Mở danh sách mọi câu còn thiếu (đáp án, Đúng/Sai, đáp số, phương án, tiêu đề phần…): bấm Đến để tới từng câu, sửa xong bấm Rà lại."/><bt:String id="T.Xuat" DefaultValue="Mở bản Giáo viên và bản Học sinh ở 2 cửa sổ Word mới. File đang soạn giữ nguyên (được lưu trước khi xuất)."/><bt:String id="T.DanhSo" DefaultValue="Đánh lại số câu liên tục trong từng phần ngay trên file đang soạn, giữ nguyên trình bày."/><bt:String id="T.XoaDA1" DefaultValue="Bỏ gạch chân / tô màu phương án, đánh dấu Đúng/Sai, dòng &quot;Đáp án:&quot; của câu tại con nháy (hoặc các câu đang bôi đen). Lời giải giữ."/><bt:String id="T.XoaDAAll" DefaultValue="Bỏ mọi đánh dấu đáp án của cả đề (có hỏi xác nhận). Lời giải vẫn giữ."/><bt:String id="T.XoaHDG1" DefaultValue="Xóa lời giải của câu tại con nháy (hoặc các câu đang bôi đen). Đáp án vẫn giữ."/><bt:String id="T.XoaHDGAll" DefaultValue="Xóa lời giải của mọi câu và khối Hướng dẫn giải cuối đề (có hỏi xác nhận). Đáp án vẫn giữ."/><bt:String id="T.XoaHet" DefaultValue="Xóa toàn bộ đáp án và hướng dẫn giải của cả đề, thành đề trắng (có hỏi xác nhận)."/><bt:String id="T.Xoa" DefaultValue="Xóa đáp án (gạch chân, Đúng/Sai, dòng &quot;Đáp án:&quot;) hoặc hướng dẫn giải, của câu tại con nháy hoặc cả đề."/><bt:String id="T.KyHieu" DefaultValue="Mở bảng ký hiệu nổi (π λ ω Δ ± ≈ ⇒ ° Ω…): bấm là chèn tại con nháy, bảng vẫn mở để bấm tiếp. Thẻ Gõ tắt: tự định nghĩa lamda → λ, đổi khi bấm Equation."/><bt:String id="T.RaCT" DefaultValue="Tìm mọi dòng có công thức viết thô (^ _ / =, LaTeX, 1.6e-19, số mũ rơi khi chép PDF) hoặc MathType, xem trước rồi chọn dòng để đổi thành Equation (cỡ 12)."/><bt:String id="T.MoPane" DefaultValue="Mở khung Định dạng nhanh bên phải Word."/><bt:String id="T.MoWeb" DefaultValue="Mở công cụ định dạng đề (bản chính thức) trên trình duyệt."/><bt:String id="T.GioiThieu" DefaultValue="Phiên bản, hướng dẫn dùng phím Alt, sao chép thông tin lỗi."/><bt:String id="T.NangCao" DefaultValue="Mở khung Add-in hoặc công cụ định dạng đề trên web."/><bt:String id="T.R0" DefaultValue="Ghi &quot;(Kết quả làm tròn đến hàng đơn vị)&quot; vào cuối đề của câu tại con nháy."/><bt:String id="T.R1" DefaultValue="Ghi &quot;(Kết quả làm tròn đến 1 chữ số thập phân)&quot; vào cuối đề của câu tại con nháy."/><bt:String id="T.R2" DefaultValue="Ghi &quot;(Kết quả làm tròn đến 2 chữ số thập phân)&quot; vào cuối đề của câu tại con nháy."/><bt:String id="T.R3" DefaultValue="Ghi &quot;(Kết quả làm tròn đến 3 chữ số thập phân)&quot; vào cuối đề của câu tại con nháy."/><bt:String id="T.RInt" DefaultValue="Ghi &quot;(Kết quả chỉ lấy phần nguyên)&quot; vào cuối đề của câu tại con nháy."/><bt:String id="T.RSig" DefaultValue="Ghi &quot;(Kết quả làm tròn đến 2 chữ số có nghĩa)&quot; vào cuối đề của câu tại con nháy."/><bt:String id="T.RX" DefaultValue="Xóa yêu cầu làm tròn trong đề của câu tại con nháy."/><bt:String id="T.LamTron" DefaultValue="Ghi yêu cầu làm tròn kết quả vào cuối đề của câu tại con nháy (thay yêu cầu cũ nếu có). Thường dùng cho câu trả lời ngắn."/><bt:String id="GetStarted.Description" DefaultValue="Mở thẻ QL_Format trên thanh Ribbon để định dạng và xuất đề."/></bt:LongStrings>
