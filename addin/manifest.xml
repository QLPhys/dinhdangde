      <bt:LongStrings><bt:String id="T.Dung" DefaultValue="Đặt con nháy ở dòng phương án (Phần I) hoặc dòng ý a) b) c) d) (Phần II) rồi bấm: đánh dấu là đúng."/><bt:String id="T.Sai" DefaultValue="Phần II: đặt con nháy ở dòng ý rồi bấm để đánh dấu ý đó sai. Phần I: bỏ đánh dấu phương án tại con nháy."/><bt:String id="T.DapSo" DefaultValue="Câu trả lời ngắn (Phần III): con nháy ở bất kỳ đâu trong câu, bấm để nhập đáp số. Công cụ ghi dòng &quot;Đáp án: …&quot;."/><bt:String id="T.A" DefaultValue="Con nháy ở bất kỳ đâu trong câu trắc nghiệm Phần I: gạch chân nhãn A. làm đáp án đúng, bỏ đánh dấu các phương án khác."/><bt:String id="T.B" DefaultValue="Con nháy ở bất kỳ đâu trong câu trắc nghiệm Phần I: gạch chân nhãn B. làm đáp án đúng, bỏ đánh dấu các phương án khác."/><bt:String id="T.C" DefaultValue="Con nháy ở bất kỳ đâu trong câu trắc nghiệm Phần I: gạch chân nhãn C. làm đáp án đúng, bỏ đánh dấu các phương án khác."/><bt:String id="T.D" DefaultValue="Con nháy ở bất kỳ đâu trong câu trắc nghiệm Phần I: gạch chân nhãn D. làm đáp án đúng, bỏ đánh dấu các phương án khác."/><bt:String id="T.LvB" DefaultValue="Gắn nhãn mức độ Biết (B) cho câu tại con nháy hoặc các câu đang bôi đen."/><bt:String id="T.LvH" DefaultValue="Gắn nhãn mức độ Hiểu (H) cho câu tại con nháy hoặc các câu đang bôi đen."/><bt:String id="T.LvVD" DefaultValue="Gắn nhãn mức độ Vận dụng (VD) cho câu tại con nháy hoặc các câu đang bôi đen."/><bt:String id="T.LvVDC" DefaultValue="Gắn nhãn mức độ Vận dụng cao (VDC) cho câu tại con nháy hoặc các câu đang bôi đen."/><bt:String id="T.LvX" DefaultValue="Xóa nhãn mức độ của câu tại con nháy hoặc các câu đang bôi đen."/><bt:String id="T.MucDo" DefaultValue="Gắn nhãn mức độ cho câu tại con nháy (bôi đen nhiều câu để gắn cho tất cả). Tự ghép TN / DS / TLN theo phần."/><bt:String id="T.C2" DefaultValue="Gắn [CHUM-2] vào đầu đoạn dữ kiện tại con nháy."/><bt:String id="T.C3" DefaultValue="Gắn [CHUM-3] vào đầu đoạn dữ kiện tại con nháy."/><bt:String id="T.C4" DefaultValue="Gắn [CHUM-4] vào đầu đoạn dữ kiện tại con nháy."/><bt:String id="T.C5" DefaultValue="Gắn [CHUM-5] vào đầu đoạn dữ kiện tại con nháy."/><bt:String id="T.C0" DefaultValue="Xóa dấu [CHUM-n] ở đoạn tại con nháy."/><bt:String id="T.Chum" DefaultValue="Đặt con nháy ở đoạn dữ kiện dùng chung, chọn số câu đi sau dùng dữ kiện này."/><bt:String id="T.ThemHDG" DefaultValue="Thêm dòng &quot;Hướng dẫn giải&quot; ở cuối câu tại con nháy và đặt con nháy ở dòng dưới để gõ lời giải."/><bt:String id="T.XoaHDG1" DefaultValue="Xóa lời giải của câu tại con nháy (hoặc các câu đang bôi đen). Đáp án vẫn giữ."/><bt:String id="T.XoaHDGAll" DefaultValue="Xóa lời giải của mọi câu và khối Hướng dẫn giải cuối đề (có hỏi xác nhận). Đáp án vẫn giữ."/><bt:String id="T.XoaHDG" DefaultValue="Xóa phần lời giải (giữ đáp án)."/><bt:String id="T.CanXem" DefaultValue="Nhảy tới câu kế tiếp còn thiếu (đáp án, Đúng/Sai, đáp số, phương án…) và báo lý do."/><bt:String id="T.Xuat" DefaultValue="Mở bản Giáo viên và bản Học sinh ở 2 cửa sổ Word mới. File đang soạn giữ nguyên (được lưu trước khi xuất)."/><bt:String id="T.DanhSo" DefaultValue="Đánh lại số câu liên tục trong từng phần ngay trên file đang soạn, giữ nguyên trình bày."/><bt:String id="T.MoPane" DefaultValue="Mở khung Định dạng nhanh bên phải Word."/><bt:String id="T.MoWeb" DefaultValue="Mở công cụ định dạng đề (bản chính thức) trên trình duyệt."/><bt:String id="T.GioiThieu" DefaultValue="Phiên bản, hướng dẫn dùng phím Alt, sao chép thông tin lỗi."/><bt:String id="T.NangCao" DefaultValue="Mở khung Add-in hoặc công cụ định dạng đề trên web."/><bt:String id="GetStarted.Description" DefaultValue="Mở thẻ QL_Format trên thanh Ribbon để định dạng và xuất đề."/></bt:LongStrings>
